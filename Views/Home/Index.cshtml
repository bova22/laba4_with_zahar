@model IEnumerable<OnlineStore.Models.Product>

@{
    ViewData["Title"] = "Главная - Интернет-магазин";
}

<div class="container mt-5">
    <div class="row mb-4 text-center">
        <div class="col">
            <h1 class="display-4 text-primary font-weight-bold">🏪 Наш Интернет-Магазин</h1>
            <p class="lead text-muted">Лабораторная работа Олега и Захара</p>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var product in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-lg">
                        <div class="card-body d-flex flex-column justify-content-between text-center">
                            <div>
                                <h4 class="card-title text-dark font-weight-bold">@product.Name</h4>
                                <p class="card-text text-secondary px-2">@product.Description</p>
                            </div>
                            <div class="mt-3">
                                <h5 class="text-success font-weight-bold mb-1">@product.Price.ToString("C")</h5>
                                <small class="text-muted d-block mb-3">На складе: @product.Stock шт.</small>
                                <button class="btn btn-primary btn-block rounded-pill" onclick="alert('Товар @product.Name добавлен в корзину!')">
                                    🛒 В корзину
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col text-center">
                <div class="alert alert-warning py-4" role="alert">
                    <h4 class="alert-heading">Товары не найдены!</h4>
                    <p class="mb-0">Возможно, бэкенд Олега ещё не запущен или адрес в HttpClient указан неверно.</p>
                </div>
            </div>
        }
    </div>
</div>
